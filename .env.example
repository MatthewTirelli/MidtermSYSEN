# Bar Harbor Dashboard — copy to .env and fill in values.
# Traffic API (optional; default used if unset)
TRAFFIC_API_BASE_URL=https://connect.systems-apps.com/content/4579a545-541d-412e-93d4-b35ef9cbca66

# Ollama Cloud (required for "Generate AI summary"). No local Ollama server needed.
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_MODEL=gpt-oss:20b-cloud
# OLLAMA_TIMEOUT=90
